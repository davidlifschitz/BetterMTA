{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bettermta.local/schemas/api-error.schema.json",
  "title": "ApiError",
  "description": "Typed API errors. insufficient_candidate_coverage (503) is the contracted coverage-exhaustion signal (ADR-0023); details SHOULD carry CandidateCoverage fields when known.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "requestId"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_input",
            "unknown_place",
            "unknown_line",
            "no_transit_path",
            "incomplete_selected_line_satisfaction",
            "insufficient_candidate_coverage",
            "timeout",
            "data_unavailable",
            "stale_realtime",
            "rate_limited",
            "internal_error"
          ]
        },
        "message": { "type": "string" },
        "requestId": { "type": "string" },
        "details": {
          "type": "object",
          "description": "Error-specific metadata. For insufficient_candidate_coverage, prefer CandidateCoverage fields plus optional requestedLineIds (no coordinates)."
        }
      }
    }
  }
}
