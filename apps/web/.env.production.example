# Live / production defaults for BetterMTA web
# Copy to .env.production or set in the host (Fly secrets / CI).

NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ADR-0017: anonymous feedback DISABLED until privacy-reviewed transport.
NEXT_PUBLIC_FLAG_FEEDBACK=false

# Optional: leave unset unless running a result-count experiment.
# NEXT_PUBLIC_FLAG_RESULT_COUNT=3
