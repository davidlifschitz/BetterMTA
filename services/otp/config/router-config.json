{
  "configVersion": "bettermta-otp-router-2.9.0",
  "routingDefaults": {
    "numItineraries": 3,
    "walkReluctance": 2.0,
    "walkSpeed": 1.34,
    "transferSlack": "2m",
    "maxTransfers": 4,
    "itineraryFilters": {
      "nonTransitGeneralizedCostLimit": "3600 + 2.0 x"
    }
  },
  "timetableUpdates": {
    "purgeExpiredData": true,
    "maxSnapshotFrequency": "1s"
  },
  "updaters": [
    {
      "type": "stop-time-updater",
      "frequency": "30s",
      "url": "http://${BETTERMTA_DATA_HOST}/internal/feeds/nyct-gtfs",
      "feedId": "nyct-gtfs",
      "headers": {
        "Authorization": "Bearer ${BETTERMTA_INTERNAL_TOKEN}"
      },
      "backwardsDelayPropagationType": "REQUIRED_NO_DATA"
    },
    {
      "type": "stop-time-updater",
      "frequency": "30s",
      "url": "http://${BETTERMTA_DATA_HOST}/internal/feeds/nyct-gtfs-ace",
