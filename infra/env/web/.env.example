# Mobile web environment template
# PLACEHOLDER NAMES ONLY — never commit real values.
# See ../../SECRETS_POLICY.md
#
# Image: apps/web/Dockerfile (next start)
# NEXT_PUBLIC_* are bake-time build args — rebuild the image to change them.
# Production: live mode, feedback off, no fixture client graph (ADR-0017/0018).

NODE_ENV=production
PORT=3000

NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=https://api.bettermta.example
NEXT_PUBLIC_FLAG_FEEDBACK=false
NEXT_PUBLIC_APP_ENV=production

# Optional UI experiment knob
# NEXT_PUBLIC_FLAG_RESULT_COUNT=3

# Error tracking (browser DSN is often public-ish but still treat as env-managed)
NEXT_PUBLIC_ERROR_TRACKING_DSN=https://REPLACE_ME@o0.ingest.example/0
ERROR_TRACKING_DSN=https://REPLACE_ME@o0.ingest.example/0
