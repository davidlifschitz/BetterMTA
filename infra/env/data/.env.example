# Data platform (static GTFS + GTFS-RT poller) environment template
# PLACEHOLDER NAMES ONLY — never commit real values.
# See ../../SECRETS_POLICY.md

NODE_ENV=production

# Feed sources
MTA_GTFS_RT_API_KEY=REPLACE_ME_MTA_GTFS_RT_API_KEY
MTA_STATIC_GTFS_URL=https://example.invalid/gtfs/nyc-subway.zip
# Comma-separated feed endpoints (placeholders)
MTA_GTFS_RT_FEED_URLS=https://example.invalid/gtfs-rt/feed1,https://example.invalid/gtfs-rt/feed2

# Snapshot / cache
CACHE_URL=redis://USER:PASS@cache.example.internal:6379/0
REDIS_URL=redis://USER:PASS@cache.example.internal:6379/0
SNAPSHOT_OBJECT_STORE_URL=s3://REPLACE_ME_BUCKET/gtfs-archives

# Optional durable metadata
DATABASE_URL=postgres://USER:PASS@db.example.internal:5432/bettermta

# Poll / import bounds (cost + politeness guardrails)
REALTIME_POLL_INTERVAL_MS=15000
REALTIME_POLL_INTERVAL_MAX_MS=60000
STATIC_IMPORT_MAX_CONCURRENCY=1
# Freshness thresholds aligned with DATA_CONTRACT (initial)
LIVE_MAX_AGE_SECONDS=90
STALE_MAX_AGE_SECONDS=900
LAST_KNOWN_GOOD_RETENTION_SECONDS=1800

# Error tracking
ERROR_TRACKING_DSN=https://REPLACE_ME@o0.ingest.example/0
SENTRY_DSN=https://REPLACE_ME@o0.ingest.example/0

# Flags affecting ingestion
FLAG_REALTIME_ENABLED=true
