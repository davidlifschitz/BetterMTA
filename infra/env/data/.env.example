# Data platform (static GTFS + GTFS-RT poller) environment template
# PLACEHOLDER NAMES ONLY — never commit real values.
# See ../../SECRETS_POLICY.md
#
# Entrypoint: node dist/main.js (services/data/Dockerfile / package.json start)
# Health: GET /internal/health (Bearer BETTERMTA_INTERNAL_TOKEN)
# Bind: default 127.0.0.1 (compose + socat). On Fly set BETTERMTA_DATA_BIND_HOST=0.0.0.0
# (see infra/fly/data.fly.toml and infra/compose/README.md).

NODE_ENV=production

BETTERMTA_INTERNAL_PORT=8081
# BETTERMTA_DATA_BIND_HOST=127.0.0.1
# Fly activate: BETTERMTA_DATA_BIND_HOST=0.0.0.0
BETTERMTA_INTERNAL_TOKEN=REPLACE_ME_INTERNAL_TOKEN
BETTERMTA_INTERNAL_ALLOW_ANON=false
BETTERMTA_DATA_DIR=/var/bettermta/data
BETTERMTA_STATIC_REFRESH_ON_BOOT=true

# Static GTFS
BETTERMTA_STATIC_GTFS_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_subway.zip
# BETTERMTA_STATIC_MAX_BYTES=
# BETTERMTA_STATIC_TIMEOUT_MS=
# BETTERMTA_REFRESH_INTERVAL_MS=
# BETTERMTA_STATIC_RETAIN_VERSIONS=

# Realtime poller
# BETTERMTA_RT_BASE_URL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds
BETTERMTA_RT_POLL_MS=15000
# BETTERMTA_RT_POLL_MS_BY_FEED=
# BETTERMTA_RT_TIMEOUT_MS=
# BETTERMTA_RT_MAX_BYTES=
# BETTERMTA_RT_MAX_RETRIES=
# BETTERMTA_RT_MIRROR_DISK=true

# MTA realtime API key if required by feed host (provider-dependent)
MTA_GTFS_RT_API_KEY=REPLACE_ME_MTA_GTFS_RT_API_KEY

# Optional graph-build webhook after static activate
# BETTERMTA_GRAPH_BUILD_WEBHOOK=https://example.invalid/hooks/otp-rebuild

# Error tracking (optional)
ERROR_TRACKING_DSN=https://REPLACE_ME@o0.ingest.example/0

# --- NOT required for anonymous search beta ---
# DATABASE_URL=
# REDIS_URL=
# CACHE_URL=
