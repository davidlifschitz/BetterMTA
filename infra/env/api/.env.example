# Application API environment template
# PLACEHOLDER NAMES ONLY — never commit real values.
# Copy to a gitignored local file or set via `fly secrets set -a bettermta-api`.
# See ../SECRETS_POLICY.md
#
# Entrypoint: node dist/index.js (apps/api/Dockerfile)
# Health: GET /health/live , GET /health/ready
# Single replica only (in-memory rate limit).

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Adapter — production MUST be live (ADR-0018 forbids fixture)
BETTERMTA_ADAPTER_MODE=live
BETTERMTA_PERMIT_DEGRADED_READY=true
BETTERMTA_LOG_LEVEL=info
BETTERMTA_TRUST_PROXY=1
BETTERMTA_CONTRACTS_ROOT=/repo/contracts

# Internal networking (Fly private / compose service names)
BETTERMTA_DATA_INTERNAL_URL=http://bettermta-data.internal:8081
BETTERMTA_DATA_INTERNAL_TOKEN=REPLACE_ME_INTERNAL_TOKEN
BETTERMTA_OTP_URL=http://bettermta-otp.internal:8080
# Optional graph pin (prefix must match staticDatasetVersion)
# BETTERMTA_OTP_GRAPH_VERSION=mta-subway-c9c3366cdd16+otp2.9.0

BETTERMTA_DATA_STATUS_TTL_MS=5000
BETTERMTA_DATA_CATALOG_TTL_MS=60000
BETTERMTA_OTP_TIMEOUT_MS=4000
BETTERMTA_OTP_PROBE_TTL_MS=10000
BETTERMTA_REQUEST_TIMEOUT_MS=2000

# Rate limits (in-memory; single API Machine)
BETTERMTA_RATE_LIMIT_MAX=120
BETTERMTA_CHEAP_RATE_LIMIT_MAX=600
BETTERMTA_RATE_LIMIT_WINDOW_MS=60000
BETTERMTA_LINES_CACHE_TTL_MS=300000
BETTERMTA_ROUTE_CACHE_TTL_MS=30000

# Feature-flag defaults — baked into API image at /app/config/flags.json
# (COPY from infra/flags/flags.json in apps/api/Dockerfile)
FLAG_DEFAULTS_PATH=/app/config/flags.json
# Emergency overlay (JSON object). Example to enable address/POI geocode:
# FEATURE_FLAGS_JSON={"address_poi_enabled":true}
# Or direct boolean (also honored):
# BETTERMTA_ADDRESS_POI_ENABLED=false

# --- Address/POI geocoder (ADR-0022; Wave 1A) — credentials/secrets NEVER in Git ---
# Provider: none (default) | fake (CI/deterministic) | nominatim (controlled alpha)
BETTERMTA_GEOCODER_PROVIDER=none
# Nominatim / Nominatim-compatible base (public OSM or self-hosted / LocationIQ-compatible)
# BETTERMTA_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Required by Nominatim usage policy when provider=nominatim (identify your app)
# BETTERMTA_NOMINATIM_USER_AGENT=BetterMTA-Alpha/0.1 (ops-contact@example.com)
# Optional contact email appended to User-Agent
# BETTERMTA_NOMINATIM_EMAIL=ops-contact@example.com
# BETTERMTA_GEOCODER_TIMEOUT_MS=1500
# BETTERMTA_GEOCODER_MAX_ATTEMPTS=2
# BETTERMTA_GEOCODER_MIN_INTERVAL_MS=1100
# BETTERMTA_GEOCODER_QUERY_CACHE_TTL_MS=60000
# BETTERMTA_GEOCODER_RESOLVE_CACHE_TTL_MS=900000

# Error tracking (optional)
ERROR_TRACKING_DSN=https://REPLACE_ME@o0.ingest.example/0

# --- NOT used by current API (no Postgres / Redis in public-beta search path) ---
# DATABASE_URL=
# REDIS_URL=
# CACHE_URL=
