# Application API environment template
# PLACEHOLDER NAMES ONLY — never commit real values.
# Copy to a gitignored local file or set via `fly secrets set -a bettermta-api`.
# See ../SECRETS_POLICY.md

NODE_ENV=production
PORT=8080

# Public / non-secret
LOG_LEVEL=info
FLAG_DEFAULTS_PATH=/app/config/flags.json
CORS_ALLOWED_ORIGINS=https://bettermta.example

# --- secrets (placeholders) ---
MTA_GTFS_RT_API_KEY=REPLACE_ME_MTA_GTFS_RT_API_KEY
MTA_STATIC_GTFS_URL=https://example.invalid/gtfs/nyc-subway.zip

# Redis-compatible cache
CACHE_URL=redis://USER:PASS@cache.example.internal:6379/0
REDIS_URL=redis://USER:PASS@cache.example.internal:6379/0

# Postgres (feedback / experiments / benchmarks — not required for anonymous search)
DATABASE_URL=postgres://USER:PASS@db.example.internal:5432/bettermta

# Error tracking
ERROR_TRACKING_DSN=https://REPLACE_ME@o0.ingest.example/0
SENTRY_DSN=https://REPLACE_ME@o0.ingest.example/0

# Place / geocode provider (vendor TBD — backend proposal)
PLACE_PROVIDER_API_KEY=REPLACE_ME_PLACE_PROVIDER_API_KEY

# Feature-flag overrides (optional JSON blob; defaults in infra/flags/flags.json)
# FEATURE_FLAGS_JSON={"maintenance_mode":false}

# Rate-limit defaults (application-enforced; see API_CONTRACT + infra/security)
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_PLACES_PER_MIN=60
PAYLOAD_MAX_BYTES=16384
